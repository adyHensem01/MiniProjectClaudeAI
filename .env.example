# Copy this file to .env and fill in real values. Never commit .env.
ANTHROPIC_API_KEY=your_real_key_here
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MAX_TOKENS=8000
CLAUDE_TIMEOUT_SECONDS=60
CLAUDE_MAX_RETRIES=2
SEED_RESET=false
# Local:  mongodb://localhost:27017/?serverSelectionTimeoutMS=5000
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&serverSelectionTimeoutMS=5000
MONGODB_URI=mongodb://localhost:27017/?serverSelectionTimeoutMS=5000
MONGODB_DATABASE=wedding_planner
